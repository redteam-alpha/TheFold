# Copy to infra/.env (which is gitignored) and fill in the secrets.
# Generate each secret with:  openssl rand -base64 32     (never reuse a secret across environments)

# Pinned. Bump deliberately, together with twenty-sdk/twenty-client-sdk in apps/fold-app (ADR 0001).
TWENTY_TAG=v2.43.0

SERVER_URL=http://localhost:3000
TWENTY_PORT=3000

TWENTY_DB_PASSWORD=
ENCRYPTION_KEY=
COMMUNITY_DB_PASSWORD=

# M0 experiment only (ADR 0002):
IS_MULTIWORKSPACE_ENABLED=false
