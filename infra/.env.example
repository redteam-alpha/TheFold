# Copy to infra/.env (which is gitignored) and fill in the secrets.
# Generate each secret with:  openssl rand -base64 32     (never reuse a secret across environments)

# Pinned. Bump deliberately, together with twenty-sdk/twenty-client-sdk in apps/fold-app (ADR 0001).
TWENTY_TAG=v2.43.0

SERVER_URL=http://localhost:3000
TWENTY_PORT=3000

TWENTY_DB_PASSWORD=
ENCRYPTION_KEY=
COMMUNITY_DB_PASSWORD=

# M0 experiment only (ADR 0002):
IS_MULTIWORKSPACE_ENABLED=false

# --- The community service (apps/community-api): API, worker and setup ---
# Role passwords for the community database, and the key-encryption key. Any characters are fine (the
# service encodes them). FOLD_KEK encrypts care text and each church's Twenty credentials: back it up WITH
# the database, and never lose it, or that data is gone.
FOLD_APP_DB_PASSWORD=
FOLD_MIGRATOR_DB_PASSWORD=
FOLD_KEK=
COMMUNITY_API_PORT=4000

# The church this install serves (fake data only until the privacy checks pass). Leave FOLD_TENANT_SLUG
# empty until you have the Twenty key: setup then only migrates.
FOLD_TENANT_SLUG=
FOLD_TENANT_NAME=
FOLD_TENANT_TIMEZONE=UTC
# The key with the "The Fold service account" role (infra/README.md step 2):
FOLD_TWENTY_API_KEY=
# The secret given to Twenty's webhook for this church, if one is set up (infra/README.md section 6):
FOLD_TWENTY_WEBHOOK_SECRET=

# Optional:
# FOLD_BASE_DOMAIN=thefold.app        # serve several churches as <slug>.thefold.app
# FOLD_TURNSTILE_SECRET=              # Cloudflare Turnstile on the connection card
# FOLD_LOG_LEVEL=info
